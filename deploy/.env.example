# Bareaya production environment template
# Copy to the VPS as /root/bareaya.env, fill real values, then run setup-vps.sh
# NODE_ENV/PORT/FRONTEND_URL are handled by ecosystem.config.js — no need here.

# --- MongoDB (Atlas) ---
MONGO_URI=mongodb+srv://USER:PASS@cluster0.mongodb.net

# --- JWT ---
JWT_SECRET=change-me-to-a-long-random-string

# --- Razorpay (live keys) ---
RAZORPAY_KEY_ID=rzp_live_xxxx
RAZORPAY_KEY_SECRET=xxxx

# --- Cloudinary (product image uploads) ---
CLOUDINARY_CLOUD_NAME=your-cloud
CLOUDINARY_API_KEY=xxxx
CLOUDINARY_API_SECRET=xxxx

# --- Hostinger SMTP (order/contact email) ---
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
EMAIL_USER=noreply@bareya.in
EMAIL_PASS=xxxx
SMTP_FROM=BAREAYA <noreply@bareya.in>
# Contact form inbox (defaults to SMTP_FROM / EMAIL_USER if unset)
CONTACT_EMAIL=noreply@bareya.in

# --- SMS OTP (Pinnacle) ---
SMS_ACCESS_KEY=xxxx
SMS_SENDER_ID=BAREAY
SMS_TYPE=PM
SMS_DLT_ENTITY_ID=xxxx
SMS_DLT_TEMPLATE_ID=xxxx
# Optional overrides (used if unset):
# SMS_API_URL=https://transapi.pinnacle.in/genericapi/JSONGenericReceiver
# SMS_OTP_TEMPLATE=Your otp for skin care with BAREAYA is {OTP}

# --- Rate limiting (all optional; defaults shown) ---
# RATE_LIMIT_ENABLED=true
# RATE_PUBLIC_WINDOW_MS=900000
# RATE_PUBLIC_MAX=180
# RATE_AUTHED_WINDOW_MS=900000
# RATE_AUTHED_MAX=600
# RATE_AUTH_IP_WINDOW_MS=900000
# RATE_AUTH_IP_MAX=30
# RATE_AUTH_ACCOUNT_WINDOW_MS=900000
# RATE_AUTH_ACCOUNT_MAX=5
# RATE_AUTH_LOCKOUT_BASE_MS=30000
# RATE_AUTH_LOCKOUT_MAX_MS=21600000
# RATE_TRUST_PROXY=1