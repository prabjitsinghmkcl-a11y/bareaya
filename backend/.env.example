# ============================================================
# Copy this file to `.env` and fill in YOUR real values.
# NEVER put real credentials in this file — it is committed to git.
# ============================================================

PORT=5000

# ---- Production only ----
# Set to production to enable CSP, serve the built frontend, and restrict CORS.
# PM2 (ecosystem.config.js) sets this automatically; only uncomment here if you
# are NOT using PM2. Keep it unset for local development.
# NODE_ENV=production
# Public origin of the deployed storefront. Required in production for CORS.
FRONTEND_URL=https://bareya.in

# MongoDB connection string (replace username/password with yours)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/Bareaya?retryWrites=true&w=majority

# JSON Web Token signing secret — use a long random string:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=<your-long-random-jwt-secret>
# Login session lifetime, any value `ms` accepts (e.g. 30m, 12h, 7d).
JWT_EXPIRES_IN=7d

# Bareaya domain email (Hostinger SMTP) used to send order confirmation emails.
# The mailbox must exist in your Hostinger panel (hPanel -> Emails) and DNS
# (MX + DKIM/SPF) must be pointed at Hostinger.
EMAIL_USER=care@bareya.in
EMAIL_PASS=your-mailbox-password
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_FROM=care@bareya.in
# Inbox for Contact form submissions
CONTACT_EMAIL=your-support-email@example.com

# Pinnacle SMS gateway (transapi) for mobile OTP
SMS_API_URL=https://transapi.pinnacle.in/genericapi/JSONGenericReceiver
SMS_ACCESS_KEY=your-pinnacle-access-key
# DLT sender header MUST be exactly 6 characters and registered on the DLT portal
SMS_SENDER_ID=BAREAY
# Exact DLT-approved template text; only {OTP} is replaced. Must match the template registered for SMS_DLT_TEMPLATE_ID.
SMS_OTP_TEMPLATE=Your otp for skin care with BAREAYA is {OTP}
# Pinnacle message type. Keep whatever the portal assigned to your OTP template (pinnacle default for promo is PM)
SMS_TYPE=PM
SMS_DLT_ENTITY_ID=1701171905801135255
SMS_DLT_TEMPLATE_ID=1707175009043701662

# Cloudinary (https://cloudinary.com) — image hosting
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Razorpay (https://dashboard.razorpay.com) — key id is public, secret is NOT
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# ---- Rate limiting ----
# Master switch: set to false to disable all rate limiting (dev only)
RATE_LIMIT_ENABLED=true
# Moderate limits for public endpoints (products)
RATE_PUBLIC_MAX=180
RATE_PUBLIC_WINDOW_MS=900000
# Loose limits for authenticated user actions
RATE_AUTHED_MAX=600
RATE_AUTHED_WINDOW_MS=900000
# Strict per-IP limits on auth routes (login/register)
RATE_AUTH_IP_MAX=30
RATE_AUTH_IP_WINDOW_MS=900000
# Strict per-account limits on auth routes
RATE_AUTH_ACCOUNT_MAX=5
RATE_AUTH_ACCOUNT_WINDOW_MS=900000
# Exponential backoff: cooldown grows base * 2^(violations-1), capped at MAX
RATE_AUTH_LOCKOUT_BASE_MS=30000
RATE_AUTH_LOCKOUT_MAX_MS=21600000
# Hops behind a reverse proxy (nginx/pm2). 0 = direct client IP.
# Set to 1 when running behind the provided nginx reverse proxy
# (deploy/nginx.conf) so req.ip reflects the real client for rate limiting.
RATE_TRUST_PROXY=1